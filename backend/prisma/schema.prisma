// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String       @id @default(cuid())
  email                  String       @unique
  password               String
  firstName              String
  lastName               String
  role                   Role         @default(STUDENT)
  isVerified             Boolean      @default(false)
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  authProvider           AuthProvider @default(EMAIL)
  googleId               String?      @unique
  hasCompletedOnboarding Boolean      @default(false)
  averageRating          Float        @default(0)
  bio                    String?
  expertise              String?
  isVerifiedInstructor   Boolean      @default(false)
  photo                  String?
  socialLinks            Json?
  title                  String?
  totalCourses           Int          @default(0)
  totalRevenue           Float        @default(0)
  totalReviews           Int          @default(0)
  totalStudents          Int          @default(0)

  // Relations
  createdCategories Category[]            @relation("UserCreatedCategories")
  courses           Course[]              @relation("InstructorCourses")
  enrolledCourses   Enrollment[]
  analytics         InstructorAnalytics[]
  followers         InstructorFollow[]    @relation("Following")
  following         InstructorFollow[]    @relation("Followers")
  reviews           Review[]
  recentSearches    RecentSearch[]

  // Payment relations
  payments      Payment[]
  payoutAccount PayoutAccount?
  payouts       Payout[]

  // Notification
  notifications     Notification[]
  pushToken         String? 

  // live
  liveClasses LiveClass[] @relation("InstructorLiveClasses")
  liveClassParticipations LiveClassParticipant[]

  // Refresh token
  refreshTokens RefreshToken[]  

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("UserCreatedCategories", fields: [createdById], references: [id])
  courses     Course[]
}

model Course {
  id            String       @id @default(cuid())
  title         String
  description   String?
  thumbnail     String?
  price         Float        @default(0)
  originalPrice Float?
  currency      String       @default("USD")
  level         Level        @default(BEGINNER)
  language      String       @default("English")
  duration      String?
  totalHours    Float?
  rating        Float        @default(0)
  studentsCount Int          @default(0)
  isPublished   Boolean      @default(false)
  isBestseller  Boolean      @default(false)
  isTrending    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  instructorId  String
  categoryId    String
  status        CourseStatus @default(DRAFT)
  category      Category     @relation(fields: [categoryId], references: [id])
  instructor    User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrollments   Enrollment[]
  lessons       Lesson[]
  reviews       Review[]
  sections      Section[]
  payments      Payment[]
  liveClasses LiveClass[]
}

model Section {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courseId    String
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([order])
}

model Lesson {
  id            String           @id @default(cuid())
  title         String
  description   String?
  videoUrl      String?
  videoPublicId String?
  duration      String?
  order         Int
  isPreview     Boolean          @default(false)
  isFree        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  courseId      String
  sectionId     String?
  course        Course           @relation(fields: [courseId], references: [id])
  section       Section?         @relation(fields: [sectionId], references: [id])
  progress      LessonProgress[]
}

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  courseId       String
  progress       Float            @default(0)
  isCompleted    Boolean          @default(false)
  completedAt    DateTime?
  enrolledAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  course         Course           @relation(fields: [courseId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  lessonProgress LessonProgress[]
  payment        Payment?

  @@unique([userId, courseId])
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  query     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@map("recent_searches")
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean    @default(false)
  watchedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  lesson       Lesson     @relation(fields: [lessonId], references: [id])

  @@unique([enrollmentId, lessonId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model InstructorFollow {
  id           String   @id @default(cuid())
  followerId   String
  instructorId String
  createdAt    DateTime @default(now())
  follower     User     @relation("Following", fields: [followerId], references: [id])
  instructor   User     @relation("Followers", fields: [instructorId], references: [id])

  @@unique([followerId, instructorId])
  @@index([instructorId])
  @@index([followerId])
}

model InstructorAnalytics {
  id               String                    @id @default(cuid())
  instructorId     String
  period           InstructorAnalyticsPeriod
  date             DateTime                  @default(now())
  coursesSold      Int                       @default(0)
  revenue          Float                     @default(0)
  studentsEnrolled Int                       @default(0)
  courseViews      Int                       @default(0)
  avgWatchTime     Float?
  completionRate   Float?
  instructor       User                      @relation(fields: [instructorId], references: [id])

  @@unique([instructorId, period, date])
  @@index([instructorId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Payment system (provider-agnostic — no Stripe-specific fields)
// ---------------------------------------------------------------------------

model Payment {
  id       String @id @default(cuid())
  userId   String
  courseId String

  amount   Float
  currency String @default("USD")

  status   PaymentStatus  @default(PENDING)
  provider PaymentProvider

  /// Opaque reference to the transaction on the provider's side
  /// (e.g. order id / charge id / payment intent id). Not provider-specific.
  providerReference String? @unique

  /// Raw metadata returned by the provider (receipt url, method details, etc.)
  metadata Json?

  failureReason String?
  paidAt        DateTime?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  /// Set once the payment succeeds and the enrollment is created
  enrollmentId String?     @unique
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("payments")
}

/// Where an instructor wants their earnings sent. Provider-agnostic: holds
/// whichever identifier/details the configured payout provider needs.
model PayoutAccount {
  id           String @id @default(cuid())
  instructorId String @unique

  provider PayoutProvider

  providerAccountId String?

  /// Bank/UPI/wallet details as needed by the chosen provider.
  details Json?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instructor User @relation(fields: [instructorId], references: [id])

  @@map("payout_accounts")
}

/// A withdrawal of accumulated earnings to an instructor's payout account.
model Payout {
  id           String @id @default(cuid())
  instructorId String

  amount   Float
  currency String @default("USD")

  status PayoutStatus @default(PENDING)

  /// Opaque reference to the payout/transfer on the provider's side.
  providerReference String? @unique

  failureReason String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instructor User @relation(fields: [instructorId], references: [id])

  @@index([instructorId])
  @@index([status])
  @@map("payouts")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
}

enum InstructorAnalyticsPeriod {
  DAY
  WEEK
  MONTH
  YEAR
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// Add/remove values here as you wire up actual gateways —
/// nothing else in the schema depends on which ones exist.
enum PaymentProvider {
  RAZORPAY
  PAYPAL
  ESEWA
}

enum PayoutProvider {
  BANK_TRANSFER
  PAYPAL
  UPI
  MANUAL
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}


// Notification
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?            // extra context (courseId, paymentId, etc.)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  ENROLLMENT       // student enrolled in a course
  PAYMENT_SUCCESS  // payment confirmed
  PAYMENT_FAILED   // payment failed
  NEW_REVIEW       // instructor got a new review
  COURSE_PUBLISHED // instructor's course got published by admin
  COURSE_APPROVED  // course approved/rejected
  SYSTEM           // general platform announcements
}

//  Live class
model LiveClass {
  id          String          @id @default(cuid())
  courseId    String
  instructorId String
  title       String
  description String?
  roomName    String          @unique  // Jitsi room identifier
  scheduledAt DateTime?               // null = instant class
  startedAt   DateTime?
  endedAt     DateTime?
  status      LiveClassStatus @default(SCHEDULED)
  maxParticipants Int         @default(100)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  participants LiveClassParticipant[]

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User     @relation("InstructorLiveClasses", fields: [instructorId], references: [id])

  @@index([courseId])
  @@index([instructorId])
  @@index([scheduledAt])
  @@map("live_classes")
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveClassParticipant {
  id          String   @id @default(cuid())
  liveClassId String
  userId      String

  joinedAt    DateTime @default(now())
  leftAt      DateTime?

  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, userId])
  @@index([liveClassId])
  @@index([userId])

  @@map("live_class_participants")
}

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String @unique

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())

  revokedAt DateTime?

  userAgent String?
  ipAddress String?

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id          Int      @id @default(autoincrement())

  email       String

  codeHash    String

  expiresAt   DateTime

  createdAt   DateTime @default(now())

  verifiedAt  DateTime?

  @@index([email])
}